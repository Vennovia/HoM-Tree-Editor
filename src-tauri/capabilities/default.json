
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-app-data-read",
    "fs:allow-app-data-write",
    "fs:allow-app-data-read-recursive",
    "fs:allow-app-data-write-recursive",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
